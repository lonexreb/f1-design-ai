FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Turbulent viscosity (computed by solver, initial guess)

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0.01;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 0.01;
    }

    outlet
    {
        type            calculated;
        value           uniform 0.01;
    }

    car
    {
        type            nutkWallFunction;
        value           uniform 0;
    }

    ground
    {
        type            nutkWallFunction;
        value           uniform 0;
    }

    top
    {
        type            symmetryPlane;
    }

    sides
    {
        type            symmetry;
    }
}

