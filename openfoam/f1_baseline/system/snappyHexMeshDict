FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Mesh refinement for F1 car geometry using snappyHexMesh
// Targets y+ ~ 30-50 for wall functions (k-omega SST)

castellatedMesh true;
snap            true;
addLayers       false;  // Disabled for first run (coarse mesh)

mergeTolerance  1e-6;

geometry
{
    f1_car_combined.stl
    {
        type    triSurfaceMesh;
        name    car;
    }
}

castellatedMeshControls
{
    maxLocalCells       500000;
    maxGlobalCells      2000000;
    minRefinementCells  10;
    maxLoadUnbalance    0.10;
    nCellsBetweenLevels 2;

    features
    (
        {
            file        "f1_car_combined.eMesh";
            level       3;      // Edge refinement (reduced for first run)
        }
    );

    refinementSurfaces
    {
        car
        {
            level       (2 3);  // Min/max surface refinement (reduced for first run)
            patchInfo
            {
                type    wall;
            }
        }
    }

    resolveFeatureAngle 30;

    refinementRegions
    {
        // Near-car refinement box
        refinementBox_near
        {
            mode    inside;
            type    searchableBox;
            min     (-4 -2 0);
            max     (6 2 2);
            level   1;
        }

        // Wake region
        refinementBox_wake
        {
            mode    inside;
            type    searchableBox;
            min     (3 -1.5 0);
            max     (15 1.5 1.5);
            level   1;
        }
    }

    locationInMesh (0 -10 10);  // Point inside the mesh (outside the car, far from geometry)
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch    3;
    tolerance       2.0;
    nSolveIter      100;
    nRelaxIter      5;
    nFeatureSnapIter 10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes   true;

    layers
    {
        // Boundary layer on car surface for y+ targeting
        car
        {
            nSurfaceLayers  5;
        }

        // Boundary layer on ground (moving wall)
        ground
        {
            nSurfaceLayers  3;
        }
    }

    expansionRatio      1.3;
    finalLayerThickness 0.5;
    minThickness        0.001;
    nGrow               0;
    featureAngle        130;
    maxFaceThicknessRatio 0.5;
    nSmoothSurfaceNormals 1;
    nSmoothThickness    10;
    nSmoothNormals      3;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle  90;
    nBufferCellsNoExtrude 0;
    nLayerIter          50;
}

meshQualityControls
{
    maxNonOrtho     65;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave      80;
    minVol          1e-13;
    minTetQuality   -1e30;
    minArea         -1;
    minTwist        0.02;
    minDeterminant  0.001;
    minFaceWeight   0.02;
    minVolRatio     0.01;
    minTriangleTwist -1;

    nSmoothScale    4;
    errorReduction  0.75;
}

