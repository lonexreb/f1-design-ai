# Blender
*.blend1
*.blend2

# OpenFOAM runtime output
openfoam/f1_baseline/[1-9]*
openfoam/f1_baseline/0.[0-9]*
openfoam/f1_baseline/postProcessing/
openfoam/f1_baseline/processor*
openfoam/f1_baseline/constant/polyMesh/
openfoam/f1_baseline/constant/extendedFeatureEdgeMesh/
