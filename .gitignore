# Blender output
blender/*.blend

# Results (keep JSON, ignore large files)
results/*.vtk
results/*.vtp
results/*.foam

# Vendor (cloned repos)
vendor/

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

